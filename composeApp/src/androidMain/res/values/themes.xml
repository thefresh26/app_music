<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Barras del sistema del color del papel, para que la app se vea continua. -->
    <style name="Theme.Pentagrama" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="paper">#F4EEE2</color>
</resources>
